# Copia como .env para correr en local. En Render van en Environment.

# Base de datos (Neon). Vacío = SQLite local
DATABASE_URL=

# Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=inventa-una-clave-larga
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v27.0

# Panel
SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio
MINUTOS_KEEPALIVE=0

# Bot
NOMBRE_BOT=Sofía
NOMBRE_INSTITUCION=UNIMINUTO Girardot
HORARIO_ASESORES=lunes a viernes de 8:00 a. m. a 6:00 p. m. y sábados de 8:00 a. m. a 12:00 m.
HORAS_AUTO_DEVOLVER_BOT=8
